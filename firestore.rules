rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /offices/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /imports/{importId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /caseEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /financialTransactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /base64Documents/{chunkId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.data.keys().hasAll(['documentId', 'index', 'data'])
                              && request.resource.data.keys().hasOnly(['documentId', 'index', 'data'])
                              && request.resource.data.documentId is string
                              && request.resource.data.index is int
                              && request.resource.data.index >= 0
                              && request.resource.data.data is string
                              && request.resource.data.data.size() <= 400000;
      }

      match /reminders/{reminderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }
  }
}
